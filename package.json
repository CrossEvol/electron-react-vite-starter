{
  "name": "electron-vite-react",
  "version": "0.0.2-snapshot",
  "type": "module",
  "main": "dist-electron/main/index.js",
  "description": "Electron Vite React boilerplate.",
  "author": "296662402@qq.com",
  "license": "MIT",
  "private": true,
  "debug": {
    "env": {
      "VITE_DEV_SERVER_URL": "http://127.0.0.1:7777/"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "rebuild": ".\\node_modules\\.bin\\electron-rebuild.cmd -f -m ./node_modules/better-sqlite3",
    "reset": "rm -rf ./node_modules/better-sqlite3 && npm install better-sqlite3",
    "preview": "vite preview",
    "pree2e": "vite build --mode=test",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "e2e": "playwright test",
    "test": "vitest",
    "generate": "drizzle-kit generate:sqlite",
    "migrate": "tsx migrate.ts",
    "studio": "drizzle-kit studio"
  },
  "dependencies": {
